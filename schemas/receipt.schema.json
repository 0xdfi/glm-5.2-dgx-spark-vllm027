{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0xdfi.example/schemas/receipt.schema.json",
  "title": "Champion evidence receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "receipt_type",
    "command",
    "created_at",
    "subject",
    "evidence",
    "result",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"$ref": "#/$defs/sha256"},
    "receipt_type": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "command": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "subject": {"$ref": "#/$defs/subject"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "result": {"enum": ["PASS", "FAIL", "PROVISIONAL"]},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "git_commit": {"$ref": "#/$defs/gitSha"},
        "run_id": {"type": "string", "minLength": 1},
        "workflow_run_id": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1},
        "profile": {"enum": ["fast-320k", "balanced-650k", "large-1m"]},
        "claim": {"type": "string", "minLength": 1},
        "attempt": {"type": "integer", "minimum": 1, "maximum": 5},
        "valid": {"type": "boolean"},
        "thresholds_passed": {"type": "boolean"},
        "median_threshold_passed": {"type": "boolean"},
        "normalized_outputs_equal": {"type": "boolean"},
        "source_equivalent": {"type": "boolean"},
        "rights_status": {"enum": ["verified", "unknown", "denied"]},
        "registry_license_cleared": {"type": "boolean"},
        "registry_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "anyOf": [
        {"required": ["source_release_id"]},
        {"required": ["build_subject_id"]},
        {"required": ["build_lock_id"]},
        {"required": ["source_manifest_id"]},
        {"required": ["image_digest"]},
        {"required": ["model_id"]},
        {"required": ["sidecar_id"]},
        {"required": ["preset_id"]},
        {"required": ["pin_id"]},
        {"required": ["tokenizer_id"]},
        {"required": ["sampling_id"]}
      ],
      "properties": {
        "source_release_id": {"$ref": "#/$defs/sha256"},
        "build_subject_id": {"$ref": "#/$defs/sha256"},
        "build_lock_id": {"$ref": "#/$defs/sha256"},
        "source_manifest_id": {"$ref": "#/$defs/sha256"},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "model_id": {"$ref": "#/$defs/sha256"},
        "sidecar_id": {"$ref": "#/$defs/sha256"},
        "preset_id": {"$ref": "#/$defs/sha256"},
        "pin_id": {"$ref": "#/$defs/sha256"},
        "tokenizer_id": {"$ref": "#/$defs/sha256"},
        "sampling_id": {"$ref": "#/$defs/sha256"},
        "run_id": {"type": "string", "minLength": 1}
      }
    }
  }
}

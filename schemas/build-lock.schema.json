{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0xdfi.example/schemas/build-lock.schema.json",
  "title": "Champion runtime build lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "architecture",
    "python",
    "cuda",
    "base_image",
    "sources",
    "artifacts",
    "toolchain",
    "build_flags",
    "manifests"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "architecture": {"const": "aarch64"},
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {"type": "string", "pattern": "^3\\.12\\.[0-9]+$"}
      }
    },
    "cuda": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "architectures"],
      "properties": {
        "version": {"type": "string", "pattern": "^13\\.0\\.2(?:[-+][0-9A-Za-z.-]+)?$"},
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "base_image": {
      "type": "string",
      "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "toolchain": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/tool"}
    },
    "build_flags": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "manifests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_source_sha256", "native_source_sha256"],
      "properties": {
        "python_source_sha256": {"$ref": "#/$defs/sha256"},
        "native_source_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "commit", "tree"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "commit": {"$ref": "#/$defs/gitSha"},
        "tree": {"$ref": "#/$defs/gitSha"},
        "tag": {"type": "string", "minLength": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

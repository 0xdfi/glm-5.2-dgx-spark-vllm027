+# SPDX-License-Identifier: Apache-2.0
+from __future__ import annotations
+
+import ast
+import hashlib
+import math
+import struct
+import unittest
+from pathlib import Path
+
+from tests.v1.attention.pr82_b12x_368_reference import (
+    FLT_MIN,
+    RECORD_BYTES,
+    ROPE_PAYLOAD_OFFSET,
+    ROPE_SCALE_OFFSET,
+    decode_record,
+    encode_record,
+    write_slot,
+)
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+class TestCompactRecordGoldenVectors(unittest.TestCase):
+    def _vectors(self):
+        return {
+            "zero": ([0.0] * 512, [0.0] * 64),
+            "ramp": (
+                [((i % 37) - 18) / 3 for i in range(512)],
+                [((i % 17) - 8) * 0.25 for i in range(64)],
+            ),
+            "boundary": (
+                [
+                    (-1 if i % 2 else 1) * (6.0 if i % 7 == 0 else 0.5 * (i % 13))
+                    for i in range(512)
+                ],
+                [
+                    (-1 if i % 2 else 1) * (448.0 if i % 11 == 0 else (i + 1) / 64)
+                    for i in range(64)
+                ],
+            ),
+        }
+
+    def test_golden_sha256(self):
+        expected = {
+            "zero": "6ec5629a0bc6e8d25ab9047d09697e012dfdb4edfe2522f1222b81d308cca35c",
+            "ramp": "529eb04f5753c5fcedbad5f9e43f453f47b4aa8af1858b75d19cb5984027a3cb",
+            "boundary": (
+                "108a7255a3111dd67415a93016e62dfb231bc8d546b7486fa6787c7671dc2faf"
+            ),
+        }
+        for name, (latent, rope) in self._vectors().items():
+            with self.subTest(name=name):
+                record = encode_record(latent, rope)
+                self.assertEqual(len(record), RECORD_BYTES)
+                self.assertEqual(hashlib.sha256(record).hexdigest(), expected[name])
+                self.assertEqual(
+                    record[ROPE_SCALE_OFFSET + 4 : ROPE_PAYLOAD_OFFSET], bytes(12)
+                )
+
+    def test_zero_record_has_positive_flt_min_rope_scale(self):
+        record = encode_record([0.0] * 512, [0.0] * 64)
+        self.assertEqual(
+            struct.unpack_from("<f", record, ROPE_SCALE_OFFSET)[0], FLT_MIN
+        )
+        latent, rope = decode_record(record)
+        self.assertEqual(latent, (0.0,) * 512)
+        self.assertEqual(rope, (0.0,) * 64)
+
+    def test_decode_is_finite_and_preserves_sign(self):
+        latent = [((i % 37) - 18) / 3 for i in range(512)]
+        rope = [((i % 17) - 8) * 0.25 for i in range(64)]
+        decoded_latent, decoded_rope = decode_record(encode_record(latent, rope))
+        self.assertTrue(all(math.isfinite(value) for value in decoded_latent))
+        self.assertTrue(all(math.isfinite(value) for value in decoded_rope))
+        self.assertLess(decoded_latent[0], 0.0)
+        self.assertGreater(decoded_latent[19], 0.0)
+        self.assertLess(decoded_rope[0], 0.0)
+        self.assertGreater(decoded_rope[9], 0.0)
+
+    def test_outer_scale_only_changes_latent_region(self):
+        latent = [((i % 29) - 14) / 8 for i in range(512)]
+        rope = [((i % 13) - 6) / 16 for i in range(64)]
+        identity = encode_record(latent, rope, outer_scale=1.0)
+        scaled = encode_record(latent, rope, outer_scale=2.0)
+        self.assertEqual(identity[ROPE_SCALE_OFFSET:], scaled[ROPE_SCALE_OFFSET:])
+        self.assertNotEqual(identity[:ROPE_SCALE_OFFSET], scaled[:ROPE_SCALE_OFFSET])
+        decoded_latent, decoded_rope = decode_record(scaled, outer_scale=2.0)
+        self.assertEqual(decoded_rope, decode_record(identity)[1])
+        self.assertEqual(len(decoded_latent), len(latent))
+
+    def test_fail_closed_nonfinite_and_padding(self):
+        latent = [0.0] * 512
+        rope = [0.0] * 64
+        for bad in (float("nan"), float("inf"), float("-inf")):
+            with self.subTest(bad=bad):
+                candidate = latent.copy()
+                candidate[17] = bad
+                with self.assertRaisesRegex(ValueError, "finite"):
+                    encode_record(candidate, rope)
+        record = bytearray(encode_record(latent, rope))
+        record[300] = 1
+        with self.assertRaisesRegex(ValueError, "padding"):
+            decode_record(bytes(record))
+
+    def test_negative_slot_is_noop_and_slots_do_not_overlap(self):
+        storage = bytearray([0xA5] * (3 * RECORD_BYTES))
+        before = bytes(storage)
+        write_slot(storage, -1, [0.0] * 512, [0.0] * 64)
+        self.assertEqual(bytes(storage), before)
+        write_slot(storage, 1, [0.0] * 512, [0.0] * 64)
+        self.assertEqual(storage[:RECORD_BYTES], before[:RECORD_BYTES])
+        self.assertEqual(storage[2 * RECORD_BYTES :], before[2 * RECORD_BYTES :])
+        self.assertNotEqual(
+            storage[RECORD_BYTES : 2 * RECORD_BYTES],
+            before[RECORD_BYTES : 2 * RECORD_BYTES],
+        )
+
+
+class TestSourceAndAllocatorContract(unittest.TestCase):
+    def test_writer_layout_and_fail_closed_binding_are_in_tree(self):
+        source = (ROOT / "csrc/libtorch_stable/cache_kernels.cu").read_text()
+        self.assertIn("constexpr int kRecordBytes = 368", source)
+        self.assertIn("constexpr int kRopeOffset = 304", source)
+        self.assertIn("static_assert(kRopeScaleOffset == 288)", source)
+        self.assertIn("kv_cache.size(2) == 368", source)
+        self.assertIn("FLT_MIN", source)
+        self.assertIn("1.0f / latent_outer_scale", source)
+        bindings = (ROOT / "vllm/_custom_ops.py").read_text()
+        self.assertNotIn("_nvfp4_mla_cache_C.so", bindings)
+        self.assertIn("no external shared-library fallback is permitted", bindings)
+
+    def test_b12x_nvfp4_kwargs_do_not_change_fp8_call_signatures(self):
+        path = ROOT / "vllm/v1/attention/backends/mla/b12x_mla_sparse.py"
+        tree = ast.parse(path.read_text())
+        calls = [
+            node
+            for node in ast.walk(tree)
+            if isinstance(node, ast.Call)
+            and isinstance(node.func, ast.Attribute)
+            and node.func.attr
+            in {"_sparse_mla_decode_forward", "_sparse_mla_extend_forward"}
+        ]
+        self.assertEqual(len(calls), 6)
+        for call in calls:
+            named_kwargs = {keyword.arg for keyword in call.keywords}
+            self.assertNotIn("latent_scale", named_kwargs)
+            self.assertNotIn("scale_format", named_kwargs)
+            self.assertTrue(
+                any(
+                    keyword.arg is None
+                    and isinstance(keyword.value, ast.Call)
+                    and isinstance(keyword.value.func, ast.Attribute)
+                    and keyword.value.func.attr == "_b12x_nvfp4_kwargs"
+                    for keyword in call.keywords
+                ),
+                f"missing NVFP4-only kwargs gate at line {call.lineno}",
+            )
+        source = path.read_text()
+        self.assertIn(
+            "if self._b12x_scale_format is None:\n            return {}", source
+        )
+        self.assertIn('"scale_format": self._b12x_scale_format', source)
+        self.assertIn('"latent_scale": latent_scale', source)
+        self.assertNotIn("latent_scale=latent_scale", source)
+        self.assertNotIn("latent_scale=1.0", source)
+        self.assertNotIn("the 432 B record", source)
+        self.assertIn("KV_FP8_ROPE=1 before process start", source)
+
+    def test_nvfp4_writer_guards_outer_scale_before_cache_mutation(self):
+        source = (ROOT / "csrc/libtorch_stable/cache_kernels.cu").read_text()
+        start = source.index("__global__ void concat_and_cache_nvfp4_mla_kernel")
+        end = source.index("\n}\n#endif", start)
+        writer = source[start:end]
+        scale_load = writer.index("const float latent_outer_scale = *outer_scale;")
+        scale_guard = writer.index(
+            "if (!isfinite(latent_outer_scale) || latent_outer_scale <= 0.0f)"
+        )
+        cache_address = writer.index("uint8_t* __restrict__ token_dst")
+        first_write = writer.index("reinterpret_cast<uint64_t*>(data_dst)[0]")
+        self.assertLess(scale_load, scale_guard)
+        self.assertLess(scale_guard, cache_address)
+        self.assertLess(cache_address, first_write)
+
+    def test_allocator_math_and_dcp4_accounting(self):
+        block_size = 64
+        fp8_record = 656
+        nvfp4_record = RECORD_BYTES
+        self.assertEqual(block_size * nvfp4_record, 23_552)
+        self.assertAlmostEqual(nvfp4_record / fp8_record, 0.5609756097560976)
+        logical_pool = 1_048_576
+        dcp_world_size = 4
+        local_tokens = logical_pool // dcp_world_size
+        local_blocks = local_tokens // block_size
+        self.assertEqual(local_tokens, 262_144)
+        self.assertEqual(local_blocks, 4_096)
+        self.assertEqual(local_blocks * block_size * nvfp4_record, 96_468_992)
+        self.assertEqual(local_tokens * dcp_world_size, logical_pool)
+
+    def test_sm121a_gencode_contract(self):
+        cmake = (ROOT / "CMakeLists.txt").read_text()
+        self.assertIn('set(CUDA_REQUESTED_ARCHS "${CUDA_ARCHS}")', cmake)
+        self.assertIn('"csrc/libtorch_stable/cache_kernels.cu"', cmake)
+        self.assertIn("VLLM_STABLE_DEFAULT_GENCODE_SRCS", cmake)
+        self.assertIn('if("12.1a" IN_LIST CUDA_REQUESTED_ARCHS)', cmake)
+        self.assertIn('CUDA_ARCHS "12.1a"', cmake)
+        self.assertNotIn("FP4_SM120_GENCODE_SRCS", cmake)
+        self.assertNotIn(
+            '"csrc/libtorch_stable/cache_kernels.cu"\n      ${FP4_SM120_SRCS}',
+            cmake,
+        )
+
+
+if __name__ == "__main__":
+    unittest.main()

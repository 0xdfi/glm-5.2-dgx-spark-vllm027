new file mode 100644
index 0000000000000000000000000000000000000000..b0b3541a1000e235a4e6088bf5ddee76289dfba0
--- /dev/null
+++ b/tests/v1/attention/pr82_b12x_368_reference.py
@@ -0,0 +1,180 @@
+# SPDX-License-Identifier: Apache-2.0
+"""CPU oracle for the 368-byte PR82/B12X GLM sparse-MLA record.
+
+This test-only module is independent of CUDA and runtime imports. The first
+288 bytes follow the Apache-2.0 PR82 latent convention. The compact RoPE tail
+implements the public B12X reader ABI using the public vLLM FP8 scale policy.
+"""
+
+from __future__ import annotations
+
+import math
+import struct
+from collections.abc import Sequence
+
+LATENT_ELEMENTS = 512
+ROPE_ELEMENTS = 64
+GROUP_ELEMENTS = 16
+PACKED_LATENT_BYTES = 256
+LATENT_SCALE_BYTES = 32
+ROPE_SCALE_OFFSET = 288
+ROPE_PAYLOAD_OFFSET = 304
+RECORD_BYTES = 368
+E2M1_MAX = 6.0
+E4M3FN_MAX = 448.0
+FLT_MIN = 1.1754943508222875e-38
+
+_E2M1_MAGNITUDES = (0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0)
+
+
+def _f32(value: float) -> float:
+    return struct.unpack("<f", struct.pack("<f", value))[0]
+
+
+def _e4m3fn_decode_positive(code: int) -> float:
+    if not 0 <= code <= 0x7E:
+        raise ValueError(f"not a positive finite E4M3FN code: {code:#04x}")
+    exponent = (code >> 3) & 0x0F
+    mantissa = code & 0x07
+    if exponent == 0:
+        return mantissa * (2.0**-9)
+    return (1.0 + mantissa / 8.0) * (2.0 ** (exponent - 7))
+
+
+_E4M3FN_POSITIVE = tuple(_e4m3fn_decode_positive(code) for code in range(0x7F))
+
+
+def _e4m3fn_encode_positive(value: float) -> int:
+    if not math.isfinite(value) or value < 0.0:
+        raise ValueError("E4M3FN input must be finite and non-negative")
+    value = min(_f32(value), E4M3FN_MAX)
+    return min(
+        range(0x7F),
+        key=lambda code: (
+            abs(_E4M3FN_POSITIVE[code] - value),
+            code & 1,
+            code,
+        ),
+    )
+
+
+def _e4m3fn_encode(value: float) -> int:
+    if not math.isfinite(value):
+        raise ValueError("E4M3FN input must be finite")
+    sign = 0x80 if math.copysign(1.0, value) < 0.0 else 0
+    return sign | _e4m3fn_encode_positive(abs(value))
+
+
+def _e4m3fn_decode(code: int) -> float:
+    magnitude = _e4m3fn_decode_positive(code & 0x7F)
+    return -magnitude if code & 0x80 else magnitude
+
+
+def _e2m1_encode(value: float) -> int:
+    if not math.isfinite(value):
+        raise ValueError("E2M1 input must be finite")
+    magnitude = min(abs(_f32(value)), E2M1_MAX)
+    code = min(
+        range(len(_E2M1_MAGNITUDES)),
+        key=lambda item: (
+            abs(_E2M1_MAGNITUDES[item] - magnitude),
+            item & 1,
+            item,
+        ),
+    )
+    sign = 0x08 if math.copysign(1.0, value) < 0.0 else 0
+    return sign | code
+
+
+def _e2m1_decode(code: int) -> float:
+    magnitude = _E2M1_MAGNITUDES[code & 0x07]
+    return -magnitude if code & 0x08 else magnitude
+
+
+def _finite_f32(values: Sequence[float], expected: int, name: str) -> list[float]:
+    if len(values) != expected:
+        raise ValueError(f"expected {expected} {name} values, got {len(values)}")
+    result = [_f32(float(value)) for value in values]
+    if not all(math.isfinite(value) for value in result):
+        raise ValueError(f"{name} values must be finite")
+    return result
+
+
+def encode_record(
+    latent: Sequence[float], rope: Sequence[float], outer_scale: float = 1.0
+) -> bytes:
+    """Encode the source-grounded 368-byte record with RN-even semantics."""
+    latent_f32 = _finite_f32(latent, LATENT_ELEMENTS, "latent")
+    rope_f32 = _finite_f32(rope, ROPE_ELEMENTS, "RoPE")
+    outer_scale = _f32(float(outer_scale))
+    if not math.isfinite(outer_scale) or outer_scale <= 0.0:
+        raise ValueError("outer_scale must be finite and positive")
+    latent_f32 = [_f32(value / outer_scale) for value in latent_f32]
+    record = bytearray(RECORD_BYTES)
+
+    for group in range(LATENT_SCALE_BYTES):
+        start = group * GROUP_ELEMENTS
+        values = latent_f32[start : start + GROUP_ELEMENTS]
+        amax = max(abs(value) for value in values)
+        scale_code = _e4m3fn_encode_positive(_f32(amax / E2M1_MAX))
+        scale = _E4M3FN_POSITIVE[scale_code]
+        inverse = _f32(1.0 / scale) if scale > 0.0 else 0.0
+        record[PACKED_LATENT_BYTES + group] = scale_code
+        for pair in range(GROUP_ELEMENTS // 2):
+            even = _e2m1_encode(_f32(values[2 * pair] * inverse))
+            odd = _e2m1_encode(_f32(values[2 * pair + 1] * inverse))
+            record[start // 2 + pair] = even | (odd << 4)
+
+    rope_amax = max(abs(value) for value in rope_f32)
+    rope_scale = _f32(max(_f32(rope_amax / E4M3FN_MAX), FLT_MIN))
+    struct.pack_into("<f", record, ROPE_SCALE_OFFSET, rope_scale)
+    # bytearray initialization plus this assignment make pad overwrite explicit.
+    record[ROPE_SCALE_OFFSET + 4 : ROPE_PAYLOAD_OFFSET] = bytes(12)
+    for index, value in enumerate(rope_f32):
+        record[ROPE_PAYLOAD_OFFSET + index] = _e4m3fn_encode(_f32(value / rope_scale))
+
+    assert len(record) == RECORD_BYTES
+    return bytes(record)
+
+
+def decode_record(
+    record: bytes, outer_scale: float = 1.0
+) -> tuple[tuple[float, ...], tuple[float, ...]]:
+    """Decode according to the public B12X reader arithmetic."""
+    if len(record) != RECORD_BYTES:
+        raise ValueError(f"expected {RECORD_BYTES} bytes, got {len(record)}")
+    if not math.isfinite(outer_scale) or outer_scale <= 0.0:
+        raise ValueError("outer_scale must be finite and positive")
+    if record[ROPE_SCALE_OFFSET + 4 : ROPE_PAYLOAD_OFFSET] != bytes(12):
+        raise ValueError("non-zero compact-record padding")
+
+    latent: list[float] = []
+    for group in range(LATENT_SCALE_BYTES):
+        scale_code = record[PACKED_LATENT_BYTES + group]
+        scale = _e4m3fn_decode_positive(scale_code) * outer_scale
+        start = group * (GROUP_ELEMENTS // 2)
+        for byte in record[start : start + GROUP_ELEMENTS // 2]:
+            latent.append(_e2m1_decode(byte & 0x0F) * scale)
+            latent.append(_e2m1_decode(byte >> 4) * scale)
+
+    rope_scale = struct.unpack_from("<f", record, ROPE_SCALE_OFFSET)[0]
+    if not math.isfinite(rope_scale) or rope_scale <= 0.0:
+        raise ValueError("invalid RoPE scale")
+    rope = tuple(
+        _e4m3fn_decode(byte) * rope_scale
+        for byte in record[ROPE_PAYLOAD_OFFSET:RECORD_BYTES]
+    )
+    return tuple(latent), rope
+
+
+def write_slot(
+    storage: bytearray, slot: int, latent: Sequence[float], rope: Sequence[float]
+) -> None:
+    """CPU slot-addressing oracle; negative slots are graph-padding no-ops."""
+    if slot < 0:
+        return
+    start = slot * RECORD_BYTES
+    end = start + RECORD_BYTES
+    if end > len(storage):
+        raise IndexError("slot exceeds storage")
+    storage[start:end] = encode_record(latent, rope)

@@ -0,0 +1,127 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Regression tests for DeepSeek/GLM MTP draft quant-config registration.
+
+The MTP draft layer builds its own ``DeepseekV2DecoderLayer`` using a
+*separate* draft quantization config (see ``get_draft_quant_config``), not the
+target model's config. For ``q_lora_rank`` models the MLA down-projection is a
+fused ``fused_qkv_a_proj`` runtime module. ModelOpt FP4/mixed configs can only
+recognize that fused runtime name as quantized by unfusing it through
+``packed_modules_mapping``. If the draft config never registers
+``fused_qkv_a_proj -> [q_a_proj, kv_a_proj_with_mqa]``, the module is built
+unquantized (plain ``weight``) and loading the checkpoint's packed
+``kv_a_proj_with_mqa.weight_packed`` shard fails with a ``KeyError``.
+
+These tests pin the registration contract on the real ``ModelOptNvFp4Config``
+per-instance mapping without needing a GPU or a checkpoint.
+"""
+
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+_MTP_MODULE = "vllm.model_executor.models.deepseek_mtp"
+
+
+def _make_hf_config(q_lora_rank):
+    return SimpleNamespace(
+        hidden_size=16,
+        rms_norm_eps=1e-5,
+        vocab_size=32,
+        index_topk=0,
+        q_lora_rank=q_lora_rank,
+    )
+
+
+def _build_mtp_layer(quant_config, q_lora_rank):
+    """Construct a DeepSeekMultiTokenPredictorLayer with heavy deps mocked.
+
+    Only the draft quant-config registration path is exercised; RMSNorm,
+    SharedHead and the decoder block are stubbed so no GPU/dist init is needed.
+    Returns the constructed layer.
+    """
+    from vllm.model_executor.models.deepseek_mtp import (
+        DeepSeekMultiTokenPredictorLayer,
+    )
+
+    hf_config = _make_hf_config(q_lora_rank)
+    vllm_config = MagicMock()
+    vllm_config.speculative_config.draft_model_config.hf_config = hf_config
+
+    with (
+        patch(f"{_MTP_MODULE}.RMSNorm"),
+        patch(f"{_MTP_MODULE}.SharedHead"),
+        patch(f"{_MTP_MODULE}.DeepseekV2DecoderLayer"),
+        patch(
+            f"{_MTP_MODULE}.get_draft_quant_config",
+            return_value=quant_config,
+        ),
+        patch(
+            f"{_MTP_MODULE}._maybe_disable_unserialized_modelopt_fp4_nextn",
+            side_effect=lambda config, vllm_cfg, qc: qc,
+        ),
+    ):
+        return DeepSeekMultiTokenPredictorLayer(vllm_config, "model.layers.61")
+
+
+def _fresh_nvfp4_config():
+    from vllm.model_executor.layers.quantization.modelopt import (
+        ModelOptNvFp4Config,
+    )
+
+    return ModelOptNvFp4Config(is_checkpoint_nvfp4_serialized=False)
+
+
+def test_mtp_registers_fused_qkv_a_proj_for_q_lora():
+    quant_config = _fresh_nvfp4_config()
+    _build_mtp_layer(quant_config, q_lora_rank=8)
+
+    mapping = quant_config.packed_modules_mapping
+    assert mapping["fused_qkv_a_proj"] == ["q_a_proj", "kv_a_proj_with_mqa"]
+    assert mapping["gate_up_proj"] == ["gate_proj", "up_proj"]
+
+
+def test_mtp_omits_fused_qkv_a_proj_without_q_lora():
+    quant_config = _fresh_nvfp4_config()
+    _build_mtp_layer(quant_config, q_lora_rank=None)
+
+    mapping = quant_config.packed_modules_mapping
+    # gate_up_proj still needed for the MoE/MLP fused columns...
+    assert mapping["gate_up_proj"] == ["gate_proj", "up_proj"]
+    # ...but there is no fused QKV-A module when q_lora_rank is unset.
+    assert "fused_qkv_a_proj" not in mapping
+
+
+def test_mtp_registration_is_per_instance_not_global():
+    quant_config = _fresh_nvfp4_config()
+    _build_mtp_layer(quant_config, q_lora_rank=8)
+
+    # A separately constructed config must not inherit the mutation: the
+    # mapping is a per-instance dict, so registering on the draft config must
+    # never leak into the target model's config.
+    other = _fresh_nvfp4_config()
+    assert other.packed_modules_mapping == {}
+

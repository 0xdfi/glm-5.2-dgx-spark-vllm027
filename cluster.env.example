# Champion site configuration. Copy to cluster.env (mode 0600) and replace only
# these symbolic values. Never put bearer tokens or passwords in this file.
CHAMPION_HOSTS=node-a,node-b,node-c,node-d
CHAMPION_FABRIC_IPS=fabric-a,fabric-b,fabric-c,fabric-d
CHAMPION_RDMA_IFNAME=fabric0
CHAMPION_IB_HCA=rdma0
CHAMPION_RDMA_UVERBS=/dev/infiniband/uverbs0
CHAMPION_RDMA_CM=/dev/infiniband/rdma_cm
CHAMPION_MODEL_PATH=/srv/champion/model
CHAMPION_CHECKPOINT_LOCK=models/checkpoint.lock.json
CHAMPION_SIDECAR_LOCK=models/sidecar.lock.json
CHAMPION_IMAGE_REF=champion-runtime@sha256:REPLACE_WITH_64_HEX_DIGEST
CHAMPION_IMAGE_ID=sha256:REPLACE_WITH_64_HEX_DIGEST
CHAMPION_API_HOST=coordinator-api
CHAMPION_API_PORT=8211
CHAMPION_RUN_ID=replace-with-unique-run-id
CHAMPION_RUN_ROOT=/var/lib/champion/runs
CHAMPION_FLEET_LOCK=/var/lock/champion-fleet
CHAMPION_STATUS_FILE=publication/status.json

# Optional safeguards and staging source. These are references, not credentials.
CHAMPION_PROTECTED_CONTAINER_PATTERN=^(hermes|openclaw|protected)
# CHAMPION_BUILDER_HOST=isolated-builder
